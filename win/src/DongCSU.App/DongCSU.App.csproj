<Project Sdk="Microsoft.NET.Sdk">

  <!--
    화면을 그리는 부분. **윈도우에서만 빌드된다.**
    맥에서 개발할 때는 이 프로젝트가 빠지고 DongCSU.Core 와 테스트만 돈다.

    XAML 을 쓰지 않는다. 창이 몇 개 안 되는데 XAML 을 끼우면 코드와 마크업 두 곳을
    맞춰야 하고, 빌드해 보지 않으면 어긋난 걸 알 수 없다. 전부 C# 으로 짠다.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 트레이 아이콘(NotifyIcon)만 WinForms 것을 쓴다. SDK 에 들어 있어 의존성이 늘지 않는다. -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- LibraryImport 가 만들어 내는 코드가 unsafe 다. 우리가 직접 쓰지는 않는다. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      테스트판과 정식판.

      **갈리는 값은 어셈블리 이름 하나뿐이다.** 나머지는 전부 거기서 파생된다 —
      설정·기록·토큰 폴더(AppPaths), 자동 시작 등록 이름(StartupService), 트레이 문구,
      버전 딱지 색, 업데이트 차단. 맥이 번들 ID 하나로 가르는 것과 같은 구조다.

          ./build.ps1          정식판  DongCSU.exe
          ./build.ps1 -Test    테스트판 DongCSU-Test.exe
    -->
    <Variant Condition="'$(Variant)' == ''">release</Variant>
    <AssemblyName Condition="'$(Variant)' == 'test'">DongCSU-Test</AssemblyName>
    <AssemblyName Condition="'$(Variant)' != 'test'">DongCSU</AssemblyName>
    <RootNamespace>DongCSU.App</RootNamespace>
    <ApplicationIcon>Resources/DongCSU.ico</ApplicationIcon>
    <!-- 런타임을 따로 깔지 않아도 되게 앱에 넣는다. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>2.4.0</Version>
  </PropertyGroup>

  <!--
    메모리.

    **이 앱의 관리 힙은 5MB 도 안 된다.** 그런데 기본 설정의 GC 는 그것에 50MB 넘게
    잡아 둔다 — 서버에서 처리량을 내려고 맞춰 둔 값이라, 하루 종일 떠 있기만 하는
    HUD 에는 그대로 낭비다. 맥판과 나란히 두면 그 차이가 그대로 보인다.

      동시 GC 끄기       백그라운드 GC 는 전용 스레드와 여분의 커밋을 들고 있는다.
                         5MB 힙에서는 멈춤이 티도 안 난다.
      ConserveMemory 5   다 쓴 구간을 미루지 않고 OS 에 돌려준다. 0~9 중 중간값.
      RetainVM 끄기      반납한 구간을 대기 목록에 쥐고 있지 않는다.

    **ReadyToRun 은 미리 컴파일해 둔다.** JIT 이 만든 코드는 전부 개인 메모리로 잡히는데,
    미리 넣어 두면 그만큼 파일에서 매핑돼 공유된다. 시작도 빨라진다.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DongCSU.Core/DongCSU.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 자체 업데이트. 사용자 폴더에 깔리고 관리자 권한을 묻지 않는다. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources/DongCSU.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      가운데 아이콘으로 고를 수 있는 Claude 앱 아이콘.

      **맥 번들에 들어가는 것과 같은 파일이다.** 사본을 두면 한쪽만 바뀌어 두 판이
      다른 그림을 그린다. 두 판이 나눠 쓰게 됐으니 언젠가 shared/ 로 옮기는 편이
      맞지만, mac/build.sh 가 Resources/ 에서 집어 가므로 그쪽을 함께 고칠 때 옮긴다.
    -->
    <EmbeddedResource Include="../../../mac/Resources/claude-icon.png" LogicalName="claude-icon.png" />

    <!--
      마스코트 규격 시트. **맥 번들에 들어가는 것과 같은 파일이다.**

      맥 2.4.0 부터 HUD·펫의 마스코트는 격자가 아니라 이 그림에서 잘라 그린다.
      사본을 두면 한쪽만 바뀌어 두 판이 다른 부엉이를 그린다 — 위의 Claude 아이콘과
      같은 이유로 원본을 그대로 집어 온다.
    -->
    <EmbeddedResource Include="../../../mac/Resources/mascot.png" LogicalName="mascot.png" />
  </ItemGroup>

</Project>
