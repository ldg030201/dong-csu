{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: 감시 + 자동 재실행",
      "type": "shell",
      "command": "./dev.sh",
      "isBackground": true,
      "problemMatcher": [
        "$swiftc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}/mac"
      }
    },
    {
      "label": "빌드 + 실행 (한 번)",
      "type": "shell",
      "command": "./dev.sh once",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$swiftc"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mac"
      }
    },
    {
      "label": "HUD 렌더 (PNG)",
      "type": "shell",
      "command": "./dev.sh render ${input:sessionPercent} ${input:weeklyPercent} ${input:iconStyle}",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/mac"
      }
    },
    {
      "label": "사용량 API 확인 (--probe)",
      "type": "shell",
      "command": "swift build -c release && ./.build/release/dong-csu --probe",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/mac"
      }
    },
    {
      "label": "앱 종료",
      "type": "shell",
      "command": "pkill -f 'dong-csu.app/Contents/MacOS/dong-csu' || true",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/mac"
      }
    }
  ],
  "inputs": [
    {
      "id": "sessionPercent",
      "type": "promptString",
      "description": "세션 사용률 (0-100)",
      "default": "8"
    },
    {
      "id": "weeklyPercent",
      "type": "promptString",
      "description": "주간 사용률 (0-100)",
      "default": "60"
    },
    {
      "id": "iconStyle",
      "type": "pickString",
      "description": "가운데 아이콘",
      "options": [
        "clawd",
        "appIcon",
        "mark"
      ],
      "default": "clawd"
    }
  ]
}
