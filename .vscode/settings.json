{
  "swift.buildArguments": ["-c", "release"],
  "swift.autoGenerateLaunchConfigurations": false,
  "files.exclude": {
    "**/.build": true,
    "**/build": true
  },
  "search.exclude": {
    "**/.build": true,
    "**/build": true
  },
  "[swift]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  }
}
